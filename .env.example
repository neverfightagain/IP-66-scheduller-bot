# Telegram Bot Token от @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# ID группы в расписании КПИ (для ІП-66 это 6084)
KPI_GROUP_ID=6084

# Часовой пояс (по умолчанию киевское время)
TIMEZONE=Europe/Kyiv

# ID вашей группы в Telegram (для надежной рассылки)
CHAT_ID=-1004483900746

# Время утреннего дайджеста (формат HH:MM)
MORNING_DIGEST_TIME=08:00

# За сколько минут до пары присылать уведомление
NOTIFY_MINUTES_BEFORE=5

# Google Gemini API Keys (підтримка пулу з кількох ключів через кому для ротації при 429/500/503)
GEMINI_API_KEYS=AIzaSyA_key1...,AIzaSyB_key2...,AIzaSyC_key3...
# Або один ключ:
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Стороння резервна ШІ-модель Groq (Llama-3.3-70B) на випадок глобальних збоїв Google
GROQ_API_KEY=gsk_your_groq_api_key_here

# ID YouTube-канала с парами для автомониторинга
YOUTUBE_CHANNEL_ID=YOUR_CHANNEL_ID_HERE

# Прокси для обхода блокировок YouTube в облаке (Render, AWS, GCP и т.д.)
# Вариант 1: Бесплатный Webshare (10 прокси навсегда без карт на webshare.io)
# WEBSHARE_USERNAME=your_webshare_username
# WEBSHARE_PASSWORD=your_webshare_password
# Вариант 2: Любой HTTP/HTTPS/SOCKS5 прокси
# YOUTUBE_PROXY=http://user:password@host:port
