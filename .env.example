# Telegram Bot Token от @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# ID группы в расписании КПИ (для ІП-66 это 6084)
KPI_GROUP_ID=6084

# Часовой пояс (по умолчанию киевское время)
TIMEZONE=Europe/Kyiv

# ID вашей группы в Telegram (для надежной рассылки)
CHAT_ID=-1004483900746

# Время утреннего дайджеста (формат HH:MM)
MORNING_DIGEST_TIME=08:00

# За сколько минут до пары присылать уведомление
NOTIFY_MINUTES_BEFORE=5

# Google Gemini API Key для анализа лекций с YouTube
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ID YouTube-канала с парами для автомониторинга
YOUTUBE_CHANNEL_ID=YOUR_CHANNEL_ID_HERE
